{
  "manifest_version": 3,
  "name": "Dashboard Bookmarks",
  "version": "1.0.0",
  "description": "Кастомная страница новой вкладки с панелями закладок в стиле дашборда",
  "chrome_url_overrides": {
    "newtab": "newtab.html"
  },
  "permissions": ["storage"],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
